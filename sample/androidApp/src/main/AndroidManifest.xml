<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No READ_MEDIA_* permissions here on purpose: Pikto declares them in its own manifest and
      they merge into this one. Drop any you do not want with tools:node="remove".
    -->

    <application
        android:allowBackup="true"
        android:label="Pikto Sample"
        android:supportsRtl="true"
        android:theme="@style/Theme.PiktoSample">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:theme="@style/Theme.PiktoSample">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
